<svg width="400" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6366f1"/>
      <stop offset="100%" style="stop-color:#ec4899"/>
    </linearGradient>
  </defs>
  <rect width="400" height="400" fill="url(#bg)"/>
  <text x="200" y="200" text-anchor="middle" fill="white" font-size="24" font-family="Arial">Your Photo Here</text>
  <text x="200" y="240" text-anchor="middle" fill="rgba(255,255,255,0.7)" font-size="14" font-family="Arial">Replace in public/images/couple.jpg</text>
</svg>
